---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Elisban Pacco | Software Engineer · AI · Data",
  description = "Software Engineer & Systems Practitioner. I build systems that turn data into useful software.",
  ogImage = "/og-image.png"
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Elisban Pacco Accha" />
    <meta name="keywords" content="Software Engineer, Backend, AI, Machine Learning, Data Systems, MLOps, PostGIS, C++, PyTorch, Python, Spring Boot, Puno, Peru" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
  </head>
  <body class="bg-white text-slate-700 antialiased min-h-screen relative selection:bg-blue-100 selection:text-blue-900">
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
