---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { profile } from '../data/profile';

// Sort all projects by year descending
const sortedProjects = [...projects].sort((a, b) => parseInt(b.year) - parseInt(a.year));
---

<BaseLayout
  title={`All Projects Archive | ${profile.name}`}
  description="A comprehensive archive of engineering systems, machine learning pipelines, research experiments, and open-source software built by Elisban Pacco."
>
  <div class="mx-auto min-h-screen max-w-360 px-6 py-12 font-sans md:px-12 md:py-20 lg:px-16 xl:px-20">
    <!-- Back to home -->
    <a
      href="/"
      class="group mb-2 inline-flex items-center font-semibold leading-tight text-slate-500 hover:text-slate-900 transition-colors text-sm font-mono"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="mr-1.5 h-4 w-4 rotate-180 transition-transform group-hover:-translate-x-1"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
          clip-rule="evenodd"
        />
      </svg>
      {profile.preferredName || profile.name}
    </a>

    <!-- Page Header -->
    <header class="mb-12 mt-4">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-slate-900">
        All Projects
      </h1>
    </header>

    <!-- Desktop Table View -->
    <div class="hidden md:block overflow-x-auto">
      <table class="w-full border-collapse text-left text-sm">
        <thead class="sticky top-0 z-10 border-b border-slate-200 bg-white/95 py-4 backdrop-blur font-sans text-[11px] font-bold uppercase tracking-wider text-slate-400">
          <tr>
            <th class="py-4 pr-6 font-semibold">Year</th>
            <th class="py-4 pr-8 font-semibold">Project</th>
            <th class="py-4 pr-8 font-semibold">Description</th>
            <th class="py-4 pr-8 font-semibold">Category / Domain</th>
            <th class="py-4 pr-8 font-semibold">Built with</th>
            <th class="py-4 font-semibold text-right">Links</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          {sortedProjects.map((project) => (
            <tr class="hover:bg-slate-50/80 transition-colors group">
              <!-- Year -->
              <td class="py-4 pr-6 align-top font-mono text-xs text-slate-400">
                {project.year}
              </td>

              <!-- Project Title -->
              <td class="py-4 pr-8 align-top">
                <div class="font-bold text-slate-900 text-sm">
                  {project.title}
                </div>
              </td>

              <!-- Description -->
              <td class="py-4 pr-8 align-top text-xs text-slate-500 leading-relaxed max-w-sm">
                {project.tagline}
              </td>

              <!-- Category / Domain -->
              <td class="py-4 pr-8 align-top text-xs text-slate-600 font-medium">
                {project.category}
              </td>

              <!-- Built with -->
              <td class="py-4 pr-8 align-top">
                <div class="flex flex-wrap gap-1 max-w-xs">
                  {project.tags.map((tag) => (
                    <span class="inline-flex items-center rounded-full px-3 py-1 text-[11px] font-mono font-medium text-slate-50 bg-slate-800">
                      {tag}
                    </span>
                  ))}
                </div>
              </td>

              <!-- Links -->
              <td class="py-4 align-top text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-3 text-xs font-mono font-medium">
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noreferrer noopener"
                      class="text-slate-500 hover:text-slate-900 transition-colors inline-flex items-center gap-0.5"
                    >
                      <span>GitHub</span>
                      <span class="text-[10px]">↗</span>
                    </a>
                  )}
                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noreferrer noopener"
                      class="text-slate-500 hover:text-slate-900 transition-colors inline-flex items-center gap-0.5"
                    >
                      <span>Live</span>
                      <span class="text-[10px]">↗</span>
                    </a>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile Card View -->
    <div class="md:hidden space-y-6">
      {sortedProjects.map((project) => (
        <div class="p-5 rounded-xl border border-slate-200 bg-white shadow-xs space-y-3">
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span>{project.year}</span>
            <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-[10px]">{project.category}</span>
          </div>

          <h2 class="text-base font-bold text-slate-900">
            {project.title}
          </h2>

          

          <div class="flex flex-wrap gap-1 pt-1">
            {project.tags.map((tag) => (
              <span class="inline-flex items-center text-[10px] font-mono font-medium text-slate-50 bg-slate-800 rounded-full px-2.5 py-0.5">
                {tag}
              </span>
            ))}
          </div>

          <div class="pt-2 border-t border-slate-50 flex items-center justify-end text-[11px] font-mono font-medium">
            {project.liveUrl && (
              <a href={project.liveUrl} target="_blank" rel="noreferrer" class="text-slate-500 hover:text-slate-900 transition-colors inline-flex items-center gap-1">
                <span>{project.liveUrl.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
                <span class="text-[10px] font-sans">↗</span>
              </a>
            )}
            {project.githubUrl && !project.liveUrl && (
              <a href={project.githubUrl} target="_blank" rel="noreferrer" class="text-slate-500 hover:text-slate-900 transition-colors inline-flex items-center gap-1">
                <span>{project.githubUrl.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
                <span class="text-[10px] font-sans">↗</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Footer -->
    <footer class="mt-16 pt-8 border-t border-slate-200 text-xs font-mono text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <span>{profile.location}</span> · <span>© {new Date().getFullYear()} {profile.name}</span>
      </div>
      <div>
        <a href="/" class="group inline-flex items-center gap-1.5 font-medium text-slate-500 hover:text-slate-900 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-x-1">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to Main Portfolio
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>
