---
import { profile } from '../data/profile';

// Clean, DRY navigation structure
const navItems = [
  { label: 'About', href: '#about', id: 'about' },
  { label: 'Experience', href: '#experience', id: 'experience' },
  { label: 'Projects', href: '#projects', id: 'projects' },
];

// Structured social links for maintainability
const socialLinks = [
  {
    name: 'GitHub',
    href: profile.github,
    svgPath: "M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
  },
  {
    name: 'LinkedIn',
    href: profile.linkedin,
    svgPath: "M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
  },
  {
    name: 'X (Twitter)',
    href: profile.x,
    svgPath: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
  }
];
---

<aside class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[40%] xl:w-[38%] lg:flex-col lg:justify-between lg:py-24 py-12">
  <div>
    <!-- Profile avatar with availability badge -->
    <div class="relative mb-6 inline-block">
      <img
        src="/foto_perfil.png"
        alt={`Portrait of ${profile.preferredName || profile.name}`}
        width="160"
        height="160"
        loading="eager"
        decoding="async"
        class="h-32 w-32 rounded-full object-cover object-top shadow-md ring-1 ring-slate-900/10 sm:h-40 sm:w-40"
      />
    </div>

    <!-- Name and title -->
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-slate-900">
      <a href="/" class="hover:text-blue-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded">
        {profile.preferredName || profile.name}
      </a>
    </h1>

    <h2 class="mt-3 text-lg sm:text-xl font-medium tracking-tight text-slate-800">
      {profile.role}
    </h2>

    <p class="mt-4 max-w-xs text-sm sm:text-base leading-relaxed text-slate-600">
      {profile.tagline}
    </p>

    <!-- Geographic location badge -->
    {profile.location && (
      <div class="mt-3 flex items-center gap-1.5 text-xs font-medium text-slate-500">
        <svg class="h-3.5 w-3.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{profile.location}</span>
      </div>
    )}

    <!-- Navigation List: Declarative & Accessible -->
    <nav class="nav hidden lg:block mt-16" aria-label="Table of contents">
      <ul class="space-y-4">
        {navItems.map((item, index) => (
          <li>
            <a
              href={item.href}
              data-section={item.id}
              data-active={index === 0 ? "true" : "false"}
              aria-current={index === 0 ? "page" : undefined}
              class="nav-link group flex items-center py-2.5 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded"
            >
              <span class="nav-indicator mr-4 h-px w-8 bg-slate-300 transition-all duration-200 group-hover:w-16 group-hover:bg-blue-600 group-focus-visible:w-16 group-focus-visible:bg-blue-600 group-data-[active=true]:w-16 group-data-[active=true]:bg-blue-600" />
              <span class="nav-text text-xs font-bold uppercase tracking-widest text-slate-500 transition-colors duration-200 group-hover:text-blue-600 group-focus-visible:text-blue-600 group-data-[active=true]:text-blue-600">
                {item.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Social Icons with comfortable touch targets and uniform hover effects -->
  <ul class="mt-8 flex items-center gap-2 text-slate-400" aria-label="Social media">
    {socialLinks.map((social) => (
      <li>
        <a
          href={social.href}
          target="_blank"
          rel="noreferrer noopener"
          class="flex h-10 w-10 items-center justify-center rounded-lg text-slate-400 transition-all duration-150 hover:-translate-y-0.5 hover:bg-slate-100 hover:text-blue-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-label={social.name}
        >
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d={social.svgPath} />
          </svg>
        </a>
      </li>
    ))}

    <!-- Email -->
    <li>
      <a
        href={`mailto:${profile.email}`}
        class="flex h-10 w-10 items-center justify-center rounded-lg text-slate-400 transition-all duration-150 hover:-translate-y-0.5 hover:bg-slate-100 hover:text-blue-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
        aria-label="Send email"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>
    </li>
  </ul>
</aside>

<style>
  .nav-link[data-active="true"] .nav-indicator {
    width: 4rem;
    background-color: #2563eb;
  }
  .nav-link[data-active="true"] .nav-text {
    color: #2563eb;
  }
</style>

<!-- Scrollspy script: Declarative, leak-free, edge-case safe -->
<script>
  let scrollHandler: (() => void) | null = null;

  function setupScrollSpy() {
    if (scrollHandler) {
      window.removeEventListener('scroll', scrollHandler);
      scrollHandler = null;
    }

    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav a[data-section]'));

    if (!sections.length || !navLinks.length) return;

    function setActiveSection(id: string | null) {
      if (!id) return;
      navLinks.forEach((link) => {
        const isMatch = link.getAttribute('data-section') === id;
        link.dataset.active = isMatch ? 'true' : 'false';
        if (isMatch) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    // Handle immediate update on click
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const targetId = link.getAttribute('data-section');
        setActiveSection(targetId);
      });
    });

    let ticking = false;
    function updateActiveSection() {
      const scrollPosition = window.scrollY;
      const windowHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;

      // Top edge case: at or near top of page
      if (scrollPosition < 80) {
        setActiveSection(sections[0].getAttribute('id'));
        return;
      }

      // Bottom edge case: reached bottom of page
      if (scrollPosition + windowHeight >= docHeight - 50) {
        setActiveSection(sections[sections.length - 1].getAttribute('id'));
        return;
      }

      // Standard detection: section passing the trigger point (35% from top of viewport)
      const triggerPoint = windowHeight * 0.35;
      for (const section of sections) {
        const rect = section.getBoundingClientRect();
        if (rect.top <= triggerPoint && rect.bottom > triggerPoint) {
          setActiveSection(section.getAttribute('id'));
          return;
        }
      }
    }

    scrollHandler = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateActiveSection();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', scrollHandler, { passive: true });
    // Initial check on load
    updateActiveSection();
  }

  setupScrollSpy();
  document.addEventListener('astro:page-load', setupScrollSpy);
</script>
