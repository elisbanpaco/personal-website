---
import type { Experience } from '../data/experience';

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
---

<li class="mb-12">
  <div class="group relative grid pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:!opacity-100 lg:group-hover/list:opacity-60">
    <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-slate-50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(0,0,0,0.05)]"></div>
    
    <header class="z-10 mb-2 mt-1 text-xs font-semibold uppercase tracking-wide text-slate-400 sm:col-span-2" aria-label={experience.period}>
      {experience.period}
    </header>

    <div class="z-10 sm:col-span-6">
      <h3 class="leading-snug">
        <div>
          {experience.companyUrl ? (
            <a
              class="inline-flex items-baseline font-bold text-lg text-slate-900 hover:text-slate-900 focus-visible:text-slate-900 group/link transition-colors"
              href={experience.companyUrl}
              target="_blank"
              rel="noreferrer noopener"
              aria-label={`${experience.role} at ${experience.company} (opens in a new tab)`}
            >
              <span class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block"></span>
              <span>
                {experience.role}
                <span class="inline-block">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="inline-block h-4 w-4 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none ml-1 translate-y-px text-slate-900" aria-hidden="true"><path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"></path></svg>
                </span>
              </span>
            </a>
          ) : (
            <span class="font-bold text-lg text-slate-900">
              {experience.role}
            </span>
          )}
        </div>
      </h3>

      <div class="text-sm font-semibold text-slate-900 mt-1">
        {experience.company}
      </div>
      
      <p class="mt-2.5 text-sm leading-relaxed text-slate-600">
        {experience.description}
      </p>

      {experience.skills && (
        <ul class="mt-3.5 flex flex-wrap gap-1.5" aria-label="Technologies used">
          {experience.skills.map((skill) => (
            <li>
              <span class="inline-flex items-center rounded-full px-3 py-1 text-[11px] font-mono font-medium text-slate-50 bg-slate-800">
                {skill}
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</li>
